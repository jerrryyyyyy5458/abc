# CompareX backend environment
# Copy to `.env` in this backend folder and adjust as needed.

FLASK_ENV=development
JWT_SECRET_KEY=comparex-secret-key-change-in-production
DATABASE_URL=sqlite:///comparex.db
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173

# ---------------------------------------------------------------------------
# Email OTP Delivery (Email-only authentication)
# ---------------------------------------------------------------------------
# Providers: dev | smtp | sendgrid
#
# 1. Dev Mode (Default):
#    EMAIL_PROVIDER=dev
#    - No email credentials required.
#    - The 6-digit OTP is securely printed directly to the Flask backend console.
#    - Inspect the server terminal to view and copy the generated OTP.
#
# 2. Live SMTP (Gmail, Brevo, AWS SES, Mailgun, Postmark, Outlook):
#    EMAIL_PROVIDER=smtp
#    SMTP_HOST=smtp.example.com
#    SMTP_PORT=587
#    SMTP_USERNAME=user@example.com
#    SMTP_PASSWORD=secret_app_password
#    EMAIL_SENDER=noreply@example.com
#
# 3. Live SendGrid:
#    EMAIL_PROVIDER=sendgrid
#    SENDGRID_API_KEY=SG.xxx
#    EMAIL_SENDER=noreply@example.com
EMAIL_PROVIDER=dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_SENDER=
SENDGRID_API_KEY=
