# CompareX backend environment
# Copy to `.env` in this folder and fill in real values. Never commit `.env`.

FLASK_ENV=development
JWT_SECRET_KEY=change-this-before-production
DATABASE_URL=sqlite:///comparex.db
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# ---------------------------------------------------------------------------
# SMS OTP delivery
# ---------------------------------------------------------------------------
# Providers: auto | msg91 | twilio | dev | aws_sns
# - auto  → use MSG91/Twilio when credentials exist, otherwise console (dev)
# - msg91 → preferred for Indian numbers (requires DLT-approved template)
# - twilio → optional international swap-in
# - dev   → print OTP to Flask console only (no live SMS)
#
# If live credentials are missing, the backend ALWAYS falls back to dev mode.
SMS_PROVIDER=msg91

# MSG91 (https://control.msg91.com/)
MSG91_API_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# Template tip (India DLT): register a template that includes ##OTP##, for example:
#   CompareX
#   Your verification code is:
#   ##OTP##
#   This OTP expires in 5 minutes.
#   Never share this code with anyone.

# Optional Twilio swap-in
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional AWS SNS (not wired live yet)
AWS_SNS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email OTP (optional)
EMAIL_PROVIDER=dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_SENDER=
SENDGRID_API_KEY=
